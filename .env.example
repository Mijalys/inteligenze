# Formulario de contacto y diagnósticos (se configuran en Vercel → Settings → Environment Variables)
# Clave de https://resend.com (plan gratuito). El dominio del remitente debe estar verificado en Resend.
RESEND_API_KEY=
# Correo que recibe los mensajes del formulario
CONTACT_TO_EMAIL=
# Remitente verificado, por ejemplo: Inteligenze <web@inteligenze.com>
CONTACT_FROM_EMAIL=
