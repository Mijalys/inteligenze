---
import FluidOrb from '@/components/ui/fluid-orb'
interface Props {
  title: string
  body?: string
  primary?: { label: string; href: string }
  secondary?: { label: string; href: string }
}
const {
  title,
  body,
  primary = { label: 'Agenda un diagnóstico', href: '/contacto/' },
  secondary,
} = Astro.props
---

<section class="section">
  <div class="wrap">
    <div class="glass relative overflow-hidden px-6 py-14 sm:px-12 lg:py-20">
      <div class="glow-bottom" aria-hidden="true"></div>
      <div class="relative grid items-center gap-10 lg:grid-cols-[1.4fr_1fr]">
        <div>
          <h2 class="sheen text-[clamp(30px,4.4vw,52px)]">{title}</h2>
          {body && <p class="mt-4 max-w-xl text-lg text-mist">{body}</p>}
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href={primary.href} class="btn btn-primary">{primary.label} <span class="arrow" aria-hidden="true">→</span></a>
            {secondary && <a href={secondary.href} class="btn btn-ghost">{secondary.label}</a>}
          </div>
        </div>
        <div class="hidden justify-self-center lg:block" aria-hidden="true">
          <div class="orb-fallback float rounded-full shadow-[0_0_120px_rgb(116_255_246/0.35)]">
            <FluidOrb client:visible size={220} color="#107d78" />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
