---
import { type Case, serviceLabels } from '@/data/cases'
interface Props {
  item: Case
  headingLevel?: 'h2' | 'h3'
}
const { item, headingLevel: H = 'h3' } = Astro.props
const lead = item.metrics[0]
---

<article
  class="glass group relative flex h-full flex-col p-6 transition-colors hover:border-cyan/40"
  data-services={item.services.join(' ')}
  data-sectors={item.sectors.join('|')}
>
  <div class="flex flex-wrap items-center gap-2 text-[13px] text-muted">
    <span>{item.industry}</span>
    {item.period && <span aria-hidden="true">·</span>}
    {item.period && <span>{item.period}</span>}
  </div>
  <p class="mt-6 font-mono text-sm text-cyan">{item.client}</p>
  <H class="mt-2 text-2xl font-medium tracking-tight">
    <a href={`/casos/${item.slug}/`} class="after:absolute after:inset-0 after:rounded-[24px]">{item.title}</a>
  </H>
  <p class="mt-3 text-[15px] text-mist">{item.summary}</p>
  <div class="mt-auto flex items-end justify-between gap-4 pt-8">
    {
      lead && (
        <div>
          <p class="text-4xl font-medium tracking-tight text-white">{lead.value}</p>
          <p class="mt-1 text-[13px] text-muted">{lead.label}</p>
        </div>
      )
    }
    <span class="shrink-0 whitespace-nowrap rounded-full border border-white/12 px-3 py-1 text-[12px] text-mist">{serviceLabels[item.services[0]]}</span>
  </div>
</article>
