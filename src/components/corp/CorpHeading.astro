---
interface Props {
  kicker?: string
  title: string
  lead?: string
  id?: string
  center?: boolean
  dark?: boolean
}
const { kicker, title, lead, id, center = false, dark = false } = Astro.props
---

<div class:list={['max-w-3xl', center && 'mx-auto text-center']} data-reveal>
  {kicker && <p class="kicker mb-4">{kicker}</p>}
  <h2 id={id} class:list={['text-[clamp(30px,3.6vw,44px)] leading-[1.1]', dark ? 'text-white' : 'text-navy']}>{title}</h2>
  {lead && <p class:list={['mt-5 text-lg leading-relaxed', dark ? 'text-mist' : 'text-text-2']}>{lead}</p>}
</div>
