---
// Franja azul marino de cierre con una o dos acciones.
interface Props {
  title: string
  body?: string
  primary?: { label: string; href: string }
  secondary?: { label: string; href: string }
}
const {
  title,
  body = 'Te respondemos en menos de 48 horas, sin compromiso.',
  primary = { label: 'Agenda un diagnóstico', href: '/contacto/' },
  secondary,
} = Astro.props
---

<section class="on-dark grid-lines bg-navy text-white" aria-labelledby="cierre">
  <div class="wrap flex flex-col items-start justify-between gap-8 py-20 lg:flex-row lg:items-center">
    <div class="max-w-2xl">
      <h2 id="cierre" class="text-[clamp(28px,3.4vw,40px)] leading-tight text-white">{title}</h2>
      {body && <p class="mt-4 text-lg text-mist">{body}</p>}
    </div>
    <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
      <a href={primary.href} class="btn btn-white">{primary.label} <span class="arrow" aria-hidden="true">→</span></a>
      {secondary && <a href={secondary.href} class="btn btn-ghost">{secondary.label}</a>}
    </div>
  </div>
</section>
