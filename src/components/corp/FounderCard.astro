---
// Liderazgo: foto de src/assets/founder.jpg si existe; si no, sus iniciales.
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { founder } from '@/data/site'

const found = Object.values(
  import.meta.glob<{ default: ImageMetadata }>('/src/assets/founder.{jpg,jpeg,png,webp}', { eager: true }),
)[0]
const initials = founder.name
  .split(' ')
  .map((w) => w[0])
  .join('')
---

{
  found ? (
    <Image src={found.default} alt={`${founder.name}, ${founder.role}`} width={480} height={560} class="aspect-[6/7] w-full rounded-xl object-cover" />
  ) : (
    <div class="grid-lines flex aspect-[6/7] w-full items-center justify-center rounded-xl bg-navy" role="img" aria-label={founder.name}>
      <span class="text-7xl font-semibold tracking-tight text-white">{initials}</span>
    </div>
  )
}
