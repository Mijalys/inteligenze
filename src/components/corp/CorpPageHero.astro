---
// Cabecera de página interior: ruta, etiqueta, título y bajada, en el estilo claro.
interface Props {
  kicker?: string
  title: string
  lead?: string
  crumbs?: { name: string; path: string }[]
}
const { kicker, title, lead, crumbs } = Astro.props
---

<section class="page-hero border-b border-rule">
  <div class="wrap pb-14 pt-10 lg:pb-20">
    {
      crumbs && crumbs.length > 1 && (
        <nav aria-label="Ruta" class="text-[14px] text-text-3">
          <ol class="flex flex-wrap items-center gap-2">
            {crumbs.map((c, i) => (
              <li class="flex items-center gap-2">
                {i > 0 && <span aria-hidden="true">/</span>}
                {i < crumbs.length - 1 ? <a href={c.path} class="hover:text-navy">{c.name}</a> : <span aria-current="page" class="text-navy">{c.name}</span>}
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <div class="mt-10">
      {kicker && <p class="kicker">{kicker}</p>}
      <h1 class="mt-4 max-w-4xl text-[clamp(34px,4.4vw,54px)] leading-[1.08]">{title}</h1>
      {lead && <p class="mt-5 max-w-2xl text-lg leading-relaxed text-text-2">{lead}</p>}
      <slot />
    </div>
  </div>
</section>
