---
import Base from '@/layouts/Base.astro'
import CorpPageHero from '@/components/corp/CorpPageHero.astro'
import { site } from '@/data/site'

interface Props {
  title: string
  description: string
  path: string
}
const { title, description, path } = Astro.props
const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: title, path },
]
const updated = new Date(site.lastUpdated).toLocaleDateString('es-PE', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })
---

<Base title={title} description={description} breadcrumbs={crumbs}>
  <CorpPageHero kicker="Legales" title={title} crumbs={crumbs}>
    <p class="mt-6 text-[15px] text-text-3">Última actualización: {updated}</p>
  </CorpPageHero>
  <section class="section">
    <div class="wrap">
      <div class="prose-corp max-w-3xl">
        <slot />
      </div>
    </div>
  </section>
</Base>
