---
import '@/styles/global.css'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import { site } from '@/data/site'
import { graph, organization, person, webPage, website, breadcrumbs as crumbsSchema } from '@/lib/schema'

interface Props {
  title: string
  description: string
  /** Título sin la marca: se agrega " · Inteligenze" salvo en el Inicio */
  bareTitle?: boolean
  image?: string
  pageType?: string
  breadcrumbs?: { name: string; path: string }[]
  schema?: object[]
  noindex?: boolean
  /** Animaciones sobrias, sin rebotes ni giros (páginas de ciberseguridad y finanzas) */
  calm?: boolean
}

const {
  title,
  description,
  bareTitle = false,
  image = '/og.png',
  pageType,
  breadcrumbs,
  schema = [],
  noindex = false,
  calm = false,
} = Astro.props

const path = Astro.url.pathname
const canonical = new URL(path, site.url).toString()
const fullTitle = bareTitle ? title : `${title} · ${site.name}`
const ogImage = new URL(image, site.url).toString()

const ld = graph(
  organization(),
  person(),
  website(),
  webPage({ path, title: fullTitle, description, type: pageType }),
  ...(breadcrumbs ? [crumbsSchema(breadcrumbs)] : []),
  ...schema,
)
---

<!doctype html>
<html lang="es-PE" data-calm={calm ? "" : undefined}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="alternate" hreflang="es-PE" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" title="Resumen para modelos de lenguaje" href="/llms.txt" />
    <meta name="theme-color" content="#050b1c" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body class="min-h-dvh overflow-x-clip">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-xl focus:bg-cyan focus:px-4 focus:py-3 focus:font-semibold focus:text-ink"
      >Saltar al contenido</a
    >
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Animaciones de entrada: cada bloque entra al aparecer en pantalla, en cascada con sus vecinos.
      ;(function () {
        var targets = document.querySelectorAll('main .glass, main [data-reveal]')
        var still = matchMedia('(prefers-reduced-motion: reduce)').matches
        function countUp(el) {
          var m = el.textContent.match(/^([^\d]*)(\d+)(.*)$/)
          if (!m || still) return
          var end = +m[2], t0 = performance.now(), dur = 1200
          function step(t) {
            var p = Math.min((t - t0) / dur, 1), e = 1 - Math.pow(1 - p, 3)
            el.textContent = m[1] + Math.round(end * e) + m[3]
            if (p < 1) requestAnimationFrame(step)
          }
          requestAnimationFrame(step)
        }
        function show(el) {
          el.classList.add('is-in')
          el.querySelectorAll('[data-countup]').forEach(countUp)
        }
        if (!('IntersectionObserver' in window)) return targets.forEach(show)
        targets.forEach(function (el) {
          var item = el.parentElement && el.parentElement.tagName === 'LI' ? el.parentElement : el
          var i = item.parentElement ? Array.prototype.indexOf.call(item.parentElement.children, item) : 0
          el.style.setProperty('--delay', Math.min(i, 6) * 90 + 'ms')
          el.style.setProperty('--tilt', (i % 2 ? 2 : -2) + 'deg')
        })
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (en) {
              if (en.isIntersecting) {
                show(en.target)
                io.unobserve(en.target)
              }
            })
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        )
        targets.forEach(function (el) { io.observe(el) })
      })()
    </script>
  </body>
</html>
