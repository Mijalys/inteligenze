---
import Base from '@/layouts/Base.astro'
import CorpCta from '@/components/corp/CorpCta.astro'
import { cases, serviceLabels, type Case } from '@/data/cases'
import { caseSchema } from '@/lib/schema'
import { Picture, getImage } from 'astro:assets'
import { caseImage } from '@/lib/caseImages'
import { site } from '@/data/site'

export function getStaticPaths() {
  return cases.map((c, i) => ({
    params: { slug: c.slug },
    props: { item: c, next: cases[(i + 1) % cases.length] },
  }))
}

const { item, next } = Astro.props as { item: Case; next: Case }
const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Casos', path: '/casos/' },
  { name: item.client, path: `/casos/${item.slug}/` },
]
const facts = [
  { k: 'Rol', v: item.role },
  { k: 'Periodo', v: item.period },
  { k: 'Industria', v: item.industry },
  { k: 'Ubicación', v: item.location },
].filter((f) => f.v)
// La portada del caso también es su imagen al compartir en redes
const og = item.cover
  ? await getImage({ src: caseImage(item.cover.file), width: 1200, height: 630, fit: 'cover', position: 'top', format: 'jpg' })
  : undefined
---

<Base
  title={`Caso ${item.client}: ${item.industry.split(' · ')[0]}`}
  description={item.summary}
  pageType="ItemPage"
  breadcrumbs={crumbs}
  image={og?.src}
  schema={[caseSchema(item, og ? new URL(og.src, site.url).toString() : undefined)]}
>
  <!-- Portada del caso -->
  <section class="border-b border-rule">
    <div class="wrap pb-12 pt-10">
      <nav aria-label="Ruta" class="text-[14px] text-text-3">
        <a href="/" class="hover:text-navy">Inicio</a> / <a href="/casos/" class="hover:text-navy">Casos</a> / <span class="text-navy">{item.client}</span>
      </nav>
      <p class="kicker mt-10">{item.client}</p>
      <h1 class="mt-4 max-w-4xl text-[clamp(32px,4.2vw,52px)] leading-[1.08]">{item.title}</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-text-2">{item.summary}</p>
      <dl class="mt-10 grid grid-cols-2 gap-6 border-t border-rule pt-6 lg:grid-cols-4">
        {
          facts.map((f) => (
            <div>
              <dt class="text-[12px] font-semibold uppercase tracking-[0.08em] text-text-3">{f.k}</dt>
              <dd class="mt-1.5 font-medium">{f.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {
    item.cover && (
      <div class="wrap pt-10">
        <Picture
          src={caseImage(item.cover.file)}
          alt={item.cover.alt}
          formats={['avif', 'webp']}
          widths={[640, 1080, 1600]}
          sizes="(max-width: 1240px) 100vw, 1144px"
          loading="eager"
          class="w-full rounded-2xl border border-rule bg-surface"
        />
      </div>
    )
  }

  <!-- Resultados -->
  <section class="wrap pt-10" aria-label="Resultados">
    <ul class="grid gap-px overflow-hidden rounded-2xl border border-rule bg-rule sm:grid-cols-2 lg:grid-cols-4">
      {
        item.metrics.map((m) => (
          <li class="bg-white p-6">
            <p class="text-4xl font-semibold tracking-tight text-navy">{m.value}</p>
            <p class="mt-1.5 text-[15px] text-text-2">{m.label}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Detalle -->
  <section class="section" aria-label="Detalle del caso">
    <div class="wrap grid gap-14 lg:grid-cols-[1fr_300px]">
      <div class="prose-corp max-w-3xl">
        <h2 class="!mt-0">Contexto</h2>
        <p>{item.context}</p>
        {
          item.howItWorks && (
            <>
              <h2>Cómo funciona</h2>
              <ol>{item.howItWorks.map((d) => <li>{d}</li>)}</ol>
            </>
          )
        }
        <h2>Qué se hizo</h2>
        <ul>{item.did.map((d) => <li>{d}</li>)}</ul>
        {
          item.results && (
            <>
              <h2>Resultado</h2>
              <ul>{item.results.map((d) => <li>{d}</li>)}</ul>
            </>
          )
        }
        <p class="text-[15px] text-text-3">
          Caso del portafolio de Mijalys Silva, fundador de Inteligenze. Rol en el proyecto: {item.role}.{' '}
          <a href={item.source} rel="noopener">Ver el caso original</a>.
        </p>
      </div>

      <aside class="grid content-start gap-6 lg:sticky lg:top-24">
        <div class="rounded-2xl border border-rule bg-surface p-6">
          <h2 class="kicker">Línea de servicio</h2>
          <p class="mt-2 font-medium">{item.services.map((s) => serviceLabels[s]).join(' · ')}</p>
          <h2 class="kicker mt-6">Entregables</h2>
          <ul class="mt-2 grid gap-1.5 text-[15px] text-text-2">{item.deliverables.map((d) => <li>{d}</li>)}</ul>
          <h2 class="kicker mt-6">Tecnología</h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {item.tech.map((t) => <li class="rounded-full bg-white px-3 py-1 text-[13px] text-text-2 ring-1 ring-rule">{t}</li>)}
          </ul>
        </div>
        <a href="/contacto/" class="btn btn-navy w-full">Quiero algo similar</a>
      </aside>
    </div>
  </section>

  {
    item.gallery && item.gallery.length > 0 && (
      <section class="wrap grid gap-8 pb-20" aria-label="Galería">
        {item.gallery.map((g) => (
          <figure>
            <Picture
              src={caseImage(g.file)}
              alt={g.alt}
              formats={['avif', 'webp']}
              widths={[640, 1080, 1600]}
              sizes="(max-width: 1240px) 100vw, 1144px"
              class="mx-auto w-auto max-w-full rounded-2xl border border-rule bg-surface"
            />
            <figcaption class="mt-3 text-center text-[14px] text-text-3">{g.alt}</figcaption>
          </figure>
        ))}
      </section>
    )
  }

  <nav class="border-t border-rule bg-surface" aria-label="Siguiente caso">
    <a href={`/casos/${next.slug}/`} class="wrap group flex flex-col gap-2 py-12">
      <span class="kicker">Siguiente caso</span>
      <span class="text-[clamp(22px,3vw,34px)] font-semibold leading-tight tracking-tight group-hover:text-teal">
        {next.client}: {next.title} <span aria-hidden="true">→</span>
      </span>
    </a>
  </nav>

  <CorpCta title="¿Tu reto se parece a este?" body="Cuéntanoslo y te proponemos el plan del primer ciclo." primary={{ label: 'Contactar', href: '/contacto/' }} />
</Base>
