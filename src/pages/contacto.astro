---
import Base from '@/layouts/Base.astro'
import Icon from '@/components/Icon.astro'
import CorpPageHero from '@/components/corp/CorpPageHero.astro'
import ContactForm from '@/components/ContactForm.astro'
import { founder, homeFaqs, site } from '@/data/site'
import { faqPage } from '@/lib/schema'

const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Contacto', path: '/contacto/' },
]

const channels = [
  site.calendarUrl && { label: 'Agenda en calendario', href: site.calendarUrl, value: `Conversación de ${site.meetingMinutes} minutos`, icon: 'calendar' },
  site.whatsapp && { label: 'WhatsApp', href: `https://wa.me/${site.whatsapp}`, value: 'Escríbenos por WhatsApp', icon: 'bot' },
  site.email && { label: 'Correo', href: `mailto:${site.email}`, value: site.email, icon: 'mail' },
  { label: 'LinkedIn', href: site.linkedinCompany ?? founder.linkedin, value: site.linkedinCompany ? 'Inteligenze' : founder.name, icon: 'users' },
  { label: 'Oficina', value: `${site.city}, ${site.countryName}`, icon: 'scope' },
].filter(Boolean) as { label: string; value: string; href?: string; icon: 'calendar' | 'bot' | 'mail' | 'users' | 'scope' }[]

const next = [
  'Leemos tu mensaje y te respondemos en menos de 48 horas.',
  'Agendamos una conversación para entender tu reto.',
  'Te proponemos el diagnóstico inicial con su alcance y precio.',
]
---

<Base
  title="Contacto: agenda un diagnóstico de IA"
  description={`Cuéntanos qué necesitas. Te respondemos en menos de ${site.responseHours} horas, sin compromiso. Consultora de IA en ${site.city}, ${site.countryName}.`}
  pageType="ContactPage"
  breadcrumbs={crumbs}
  schema={[faqPage(homeFaqs, '/contacto/')]}
>
  <CorpPageHero kicker="Contacto" title="Cuéntanos qué necesitas." lead={`Te respondemos en menos de ${site.responseHours} horas, sin compromiso.`} crumbs={crumbs} />

  <section class="section" aria-label="Formulario de contacto">
    <div class="wrap grid gap-10 lg:grid-cols-[1.5fr_1fr] lg:gap-14">
      <div>
        <div class="mb-6 hidden rounded-xl border border-teal/30 bg-surface p-5 text-navy" data-sent>
          Gracias. Recibimos tu mensaje y te escribiremos pronto.
        </div>
        <ContactForm id="form-contacto" />
      </div>
      <aside class="grid content-start gap-6">
        <div class="rounded-2xl bg-navy p-7 text-white">
          <h2 class="text-[13px] font-semibold uppercase tracking-[0.08em] text-cyan">Qué pasa después</h2>
          <ol class="mt-5 grid gap-4">
            {
              next.map((n, i) => (
                <li class="grid grid-cols-[28px_1fr] gap-3">
                  <span class="flex size-7 items-center justify-center rounded-full border border-cyan/50 text-[13px] font-semibold text-cyan">{i + 1}</span>
                  <span class="leading-snug">{n}</span>
                </li>
              ))
            }
          </ol>
        </div>
        <div>
          <h2 class="kicker">Otras vías</h2>
          <ul class="mt-4 grid divide-y divide-rule rounded-2xl border border-rule">
            {
              channels.map((c) => (
                <li class="flex items-center gap-4 p-5">
                  <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-surface text-teal"><Icon name={c.icon} class="size-5" /></span>
                  <span>
                    <span class="block text-[13px] text-text-3">{c.label}</span>
                    {c.href ? <a href={c.href} class="font-semibold hover:text-teal" rel="noopener">{c.value}</a> : <span class="font-semibold">{c.value}</span>}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="section border-t border-rule bg-surface" aria-labelledby="faq">
    <div class="wrap grid gap-12 lg:grid-cols-[1fr_1.6fr] lg:gap-20">
      <div>
        <p class="kicker">Preguntas frecuentes</p>
        <h2 id="faq" class="mt-3 text-[clamp(28px,3vw,38px)] leading-tight">Antes de escribirnos</h2>
      </div>
      <div class="divide-y divide-rule border-y border-rule">
        {
          homeFaqs.map((f, i) => (
            <details class="group py-5" open={i === 0}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 [&::-webkit-details-marker]:hidden">
                <h3 class="text-lg">{f.q}</h3>
                <span class="flex size-8 shrink-0 items-center justify-center rounded-full border border-rule bg-white text-teal transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="mt-3 max-w-2xl leading-relaxed text-text-2">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<script>
  // Mensaje tras un envío sin JavaScript (el servidor redirige con ?enviado=1)
  if (new URLSearchParams(location.search).has('enviado')) {
    document.querySelector('[data-sent]')?.classList.remove('hidden')
  }
</script>
