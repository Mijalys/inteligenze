---
import Base from '@/layouts/Base.astro'
import Icon from '@/components/Icon.astro'
import CorpPageHero from '@/components/corp/CorpPageHero.astro'
import CorpHeading from '@/components/corp/CorpHeading.astro'
import CorpCaseCard from '@/components/corp/CorpCaseCard.astro'
import CorpCta from '@/components/corp/CorpCta.astro'
import { sectors, type Sector } from '@/data/sectors'
import { services } from '@/data/services'
import { getCase, type Case } from '@/data/cases'

export function getStaticPaths() {
  return sectors.map((s) => ({ params: { slug: s.slug }, props: { sector: s } }))
}

const { sector } = Astro.props as { sector: Sector }
const related = sector.relatedCases.map(getCase).filter((c): c is Case => Boolean(c))
const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Sectores', path: '/sectores/' },
  { name: sector.name, path: `/sectores/${sector.slug}/` },
]
---

<Base title={sector.title} description={sector.metaDescription} breadcrumbs={crumbs}>
  <CorpPageHero kicker={`Sector ${sector.name.toLowerCase()}`} title={sector.headline} crumbs={crumbs}>
    <div class="mt-9 flex flex-col gap-3 sm:flex-row">
      <a href="/contacto/" class="btn btn-navy">Agenda un diagnóstico <span class="arrow" aria-hidden="true">→</span></a>
      <a href="/diagnosticos/" class="btn btn-outline">Diagnósticos gratuitos</a>
    </div>
  </CorpPageHero>

  <section class="section" aria-label="Retos y soluciones">
    <div class="wrap grid gap-6 lg:grid-cols-2">
      <div class="card p-8" data-reveal>
        <p class="kicker">Retos típicos del sector</p>
        <ul class="mt-6 grid gap-4">
          {sector.challenges.map((c) => <li class="flex gap-3 text-lg leading-snug"><span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-teal" aria-hidden="true" />{c}</li>)}
        </ul>
      </div>
      <div class="rounded-2xl bg-navy p-8 text-white" data-reveal>
        <p class="text-[13px] font-semibold uppercase tracking-[0.08em] text-cyan">Qué hacemos</p>
        <ul class="mt-6 grid gap-4">
          {sector.whatWeDo.map((c) => <li class="flex gap-3 text-lg leading-snug"><Icon name="check" class="mt-1 size-5 shrink-0 text-cyan" />{c}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section border-y border-rule bg-surface" aria-labelledby="servicios">
    <div class="wrap">
      <CorpHeading id="servicios" kicker="Nuestras líneas de servicio" title={`Cómo trabajamos en ${sector.name.toLowerCase()}`} />
      <div class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        {
          services.map((s) => (
            <a href={`/servicios/${s.slug}/`} class="card flex flex-col p-6" data-reveal>
              <span class="flex size-11 items-center justify-center rounded-lg bg-surface text-teal"><Icon name={s.icon} class="size-6" /></span>
              <span class="mt-5 text-lg font-semibold">{s.name}</span>
              <span class="mt-2 text-[15px] leading-relaxed text-text-2">{s.short}</span>
              <span class="link-arrow mt-auto pt-5">{s.cardCta} →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section" aria-labelledby="experiencia">
        <div class="wrap">
          <CorpHeading id="experiencia" kicker="Experiencia relacionada" title="Lo que ya construimos y medimos" />
          <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {related.map((c) => <CorpCaseCard item={c} />)}
          </div>
        </div>
      </section>
    )
  }

  <CorpCta title="Si tu industria no aparece aquí, el método es el mismo." body="Cuéntanos tu operación y te decimos por dónde empezar." primary={{ label: 'Contactar', href: '/contacto/' }} />
</Base>
