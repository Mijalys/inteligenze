---
import Base from '@/layouts/Base.astro'
import Icon from '@/components/Icon.astro'
import CorpPageHero from '@/components/corp/CorpPageHero.astro'
import CorpCta from '@/components/corp/CorpCta.astro'
import { sectors } from '@/data/sectors'

const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Sectores', path: '/sectores/' },
]
---

<Base
  title="Sectores: IA para finanzas, automotriz y logística"
  description="Agentes de IA, automatización y ciberseguridad para entidades financieras, concesionarias y operadores logísticos en Perú."
  pageType="CollectionPage"
  breadcrumbs={crumbs}
>
  <CorpPageHero
    kicker="Sectores"
    title="Conocemos tu industria."
    lead="Trabajamos con entidades financieras, empresas automotrices y operadores logísticos. Si tu industria no aparece aquí, el método es el mismo."
    crumbs={crumbs}
  />

  <section class="section" aria-label="Sectores">
    <div class="wrap grid gap-5 md:grid-cols-3">
      {
        sectors.map((s) => (
          <a href={`/sectores/${s.slug}/`} class="card flex flex-col p-7" data-reveal>
            <span class="flex size-12 items-center justify-center rounded-xl bg-navy text-cyan"><Icon name={s.icon} class="size-6" /></span>
            <h2 class="mt-6 text-2xl">{s.name}</h2>
            <p class="mt-2 leading-relaxed text-text-2">{s.headline}</p>
            <ul class="mt-6 grid gap-2.5 border-t border-rule pt-6 text-[15px] text-text-2">
              {s.whatWeDo.map((w) => <li class="flex items-start gap-2.5"><Icon name="check" class="mt-0.5 size-4 shrink-0 text-teal" />{w}</li>)}
            </ul>
            <span class="link-arrow mt-auto pt-7">IA para {s.name.toLowerCase()} →</span>
          </a>
        ))
      }
    </div>
  </section>

  <CorpCta title="Cuéntanos tu operación." body="Te decimos dónde la IA da resultados primero en tu industria." primary={{ label: 'Contactar', href: '/contacto/' }} />
</Base>
