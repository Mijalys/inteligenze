---
import Base from '@/layouts/Base.astro'
import Icon from '@/components/Icon.astro'
import CorpHeading from '@/components/corp/CorpHeading.astro'
import { services } from '@/data/services'
import { method } from '@/data/site'
import { serviceSchema } from '@/lib/schema'

const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Servicios', path: '/servicios/' },
]
const total = services.reduce((n, s) => n + s.items.length, 0)
---

<Base
  corp
  title="Servicios: software, automatización, ciberseguridad y staffing"
  description="Desarrollo de software y agentes de IA, automatización de procesos, ciberseguridad y staffing de tecnología, con alcance, fecha y precio acordados."
  pageType="CollectionPage"
  breadcrumbs={crumbs}
  schema={services.map(serviceSchema)}
>
  <section class="border-b border-rule">
    <div class="wrap py-14 lg:py-20">
      <p class="kicker">Servicios</p>
      <h1 class="mt-4 max-w-3xl text-[clamp(34px,4.4vw,52px)] leading-[1.08]">Cuatro líneas de servicio, {total} formas de ayudarte</h1>
      <p class="mt-5 max-w-2xl text-lg text-text-2">Construimos, automatizamos, protegemos y sumamos talento. En todos los casos acordamos alcance, fecha y precio antes de empezar.</p>
      <nav class="mt-8 flex flex-wrap gap-2" aria-label="Líneas de servicio">
        {services.map((s) => <a href={`#${s.slug}`} class="flex items-center gap-2 rounded-full border border-rule px-4 py-2 text-[14px] text-text-2 hover:border-navy hover:text-navy"><Icon name={s.icon} class="size-4 text-teal" />{s.name}</a>)}
      </nav>
    </div>
  </section>

  {
    services.map((s, i) => (
      <section id={s.slug} class:list={['section scroll-mt-20', i % 2 === 1 && 'border-y border-rule bg-surface']} aria-labelledby={`h-${s.slug}`}>
        <div class="wrap grid gap-10 lg:grid-cols-[1fr_1.6fr] lg:gap-16">
          <div data-reveal>
            <span class="flex size-12 items-center justify-center rounded-xl bg-navy text-cyan"><Icon name={s.icon} class="size-6" /></span>
            <h2 id={`h-${s.slug}`} class="mt-6 text-[clamp(28px,3vw,38px)] leading-tight">{s.name}</h2>
            <p class="mt-4 text-lg leading-relaxed text-text-2">{s.short}</p>
            <a href={`/servicios/${s.slug}/`} class="link-arrow mt-6 inline-block">{s.cardCta} →</a>
          </div>
          <ul class:list={['grid gap-4 sm:grid-cols-2', s.items.length === 3 && 'lg:grid-cols-3', s.items.length > 4 && 'lg:grid-cols-3']}>
            {s.items.map((it) => (
              <li>
                <a href={`/servicios/${s.slug}/${it.slug}/`} class="card flex h-full flex-col p-5" data-reveal>
                  <Icon name={it.icon} class="size-6 text-teal" />
                  <span class="mt-4 font-semibold">{it.name}</span>
                  <span class="mt-1.5 text-[14px] leading-snug text-text-3">{it.short}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <section class="on-dark grid-lines bg-navy text-white" aria-labelledby="metodo">
    <div class="wrap py-20">
      <CorpHeading id="metodo" kicker="Cómo trabajamos" title="Un mismo método para todos los servicios" dark />
      <ol class="mt-10 grid gap-8 md:grid-cols-2 lg:grid-cols-4">
        {
          method.map((m, i) => (
            <li class="border-t border-white/15 pt-5">
              <span class="text-[14px] font-semibold text-cyan">0{i + 1}</span>
              <h3 class="mt-2 text-lg text-white">{m.title}</h3>
              <p class="mt-2 text-[15px] text-mist">{m.body}</p>
            </li>
          ))
        }
      </ol>
      <a href="/contacto/" class="btn btn-white mt-12">Agenda un diagnóstico <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>
</Base>
