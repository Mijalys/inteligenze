---
// Listado del blog. Si todavía no hay artículos publicados, la página no se genera.
import type { GetStaticPaths, Page } from 'astro'
import { getCollection, type CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'
import Base from '@/layouts/Base.astro'

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  )
  return posts.length ? paginate(posts, { pageSize: 12 }) : []
}) satisfies GetStaticPaths

const { page } = Astro.props as { page: Page<CollectionEntry<'blog'>> }
const fmt = (d: Date) => d.toLocaleDateString('es-PE', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })
const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Recursos', path: '/recursos/' },
  { name: 'Blog', path: '/blog/' },
]
---

<Base
  title={page.currentPage > 1 ? `Blog · página ${page.currentPage}` : 'Blog: IA, automatización y ciberseguridad'}
  description="Artículos prácticos sobre agentes de IA, automatización de procesos, ciberseguridad y desarrollo de software para empresas."
  pageType="CollectionPage"
  breadcrumbs={crumbs}
>
  <section class="border-b border-rule">
    <div class="wrap py-14 lg:py-20">
      <p class="kicker">Blog</p>
      <h1 class="mt-4 max-w-3xl text-[clamp(34px,4.4vw,52px)] leading-[1.08]">Ideas prácticas sobre IA para empresas</h1>
      <p class="mt-5 max-w-2xl text-lg text-text-2">Agentes, automatización, ciberseguridad y desarrollo, explicados con ejemplos reales.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        page.data.map((post) => (
          <article class="card is-link group relative flex flex-col overflow-hidden" data-reveal>
            {post.data.cover && (
              <Image src={post.data.cover} alt={post.data.coverAlt ?? ''} width={720} class="aspect-[16/9] w-full object-cover" />
            )}
            <div class="flex flex-1 flex-col p-6">
              <p class="kicker">{post.data.category}</p>
              <h2 class="mt-2 text-xl leading-snug">
                <a href={`/blog/${post.id}/`} class="after:absolute after:inset-0">{post.data.title}</a>
              </h2>
              <p class="mt-3 text-[15px] leading-relaxed text-text-2">{post.data.description}</p>
              <p class="mt-auto pt-5 text-[13px] text-text-3"><time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time></p>
            </div>
          </article>
        ))
      }
    </div>
    {
      page.lastPage > 1 && (
        <nav class="wrap mt-12 flex justify-between" aria-label="Paginación">
          {page.url.prev ? <a class="link-arrow" href={page.url.prev}>← Más recientes</a> : <span />}
          {page.url.next && <a class="link-arrow" href={page.url.next}>Anteriores →</a>}
        </nav>
      )
    }
  </section>
</Base>
