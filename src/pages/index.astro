---
import Base from '@/layouts/Base.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import Steps from '@/components/Steps.astro'
import CaseCard from '@/components/CaseCard.astro'
import Faq from '@/components/Faq.astro'
import ContactForm from '@/components/ContactForm.astro'
import FluidOrb from '@/components/ui/fluid-orb'
import { homeFaqs, method, proof, promise, site } from '@/data/site'
import { services } from '@/data/services'
import { sectors } from '@/data/sectors'
import { featuredCases } from '@/data/cases'
import { faqPage } from '@/lib/schema'

const title = 'Inteligenze | Consultora de IA en Perú: agentes y automatización'
const description =
  'Consultora de IA en Lima. Agentes y software a medida, automatización de procesos y ciberseguridad, con alcance, fecha y precio acordados antes de empezar.'
---

<Base title={title} bareTitle description={description} schema={[faqPage(homeFaqs, '/')]}>
  <!-- 1. Hero -->
  <section class="relative overflow-hidden pb-20 pt-32 lg:pb-28 lg:pt-44">
    <div class="beam" aria-hidden="true"></div>
    <div class="glow-bottom" aria-hidden="true"></div>
    <div class="wrap relative grid items-center gap-14 lg:grid-cols-[1.1fr_1fr]">
      <div>
        <p class="chip">
          <svg class="size-4 text-cyan" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6"></path></svg>
          {site.tagline}
        </p>
        <h1 class="mt-8 text-[clamp(42px,6.6vw,84px)] font-medium leading-[0.98] tracking-[-0.045em]">
          <span class="sheen">Construimos, automatizamos y protegemos tu empresa</span>{' '}
          <span class="whitespace-nowrap"><span class="brace">{'{'}</span><span class="sheen"> con IA </span><span class="brace">{'}'}</span></span>
        </h1>
        <p class="mt-7 max-w-xl text-lg text-mist sm:text-xl">
          Con resultados acordados antes de empezar. Inteligenze es una consultora de IA que diseña agentes y software a medida, automatiza procesos y refuerza tu ciberseguridad. Definimos contigo qué se entrega, cuándo y a qué costo.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href="/contacto/" class="btn btn-primary">Agenda un diagnóstico <span class="arrow" aria-hidden="true">→</span></a>
          <a href="#servicios" class="btn btn-ghost">Conoce los servicios</a>
        </div>
        <ul class="mt-12 grid gap-3 text-[15px] text-mist sm:grid-cols-3 sm:gap-6" aria-label="Respaldo">
          {
            proof.map((p) => (
              <li class="flex gap-3 border-l border-cyan/40 pl-4">{p}</li>
            ))
          }
        </ul>
      </div>

      <!-- Visual: the agreement of a cycle, as code, with the orb as the agent's core -->
      <div class="relative mx-auto mb-16 w-full max-w-[560px] lg:mx-0 lg:mb-0" aria-hidden="true">
        <div class="glass overflow-hidden">
          <div class="flex items-center justify-between border-b border-white/10 px-5 py-4">
            <div class="flex gap-2">
              <span class="size-3 rounded-full bg-[#ff5f57]"></span>
              <span class="size-3 rounded-full bg-[#febc2e]"></span>
              <span class="size-3 rounded-full bg-[#28c840]"></span>
            </div>
            <span class="font-mono text-[12px] text-muted">acuerdo-ciclo-01.ts</span>
          </div>
          <pre class="overflow-hidden px-5 py-6 font-mono text-[13px] leading-7 sm:text-[14px]"><code><span class="text-[#c792ea]">const</span> <span class="text-white">ciclo</span> = {'{'}
  <span class="text-mist">alcance</span>: <span class="text-cyan">"Agente de atención en WhatsApp"</span>,
  <span class="text-mist">criterios</span>: [<span class="text-cyan">"24/7"</span>, <span class="text-cyan">"escala a una persona"</span>],
  <span class="text-mist">fecha</span>: <span class="text-cyan">"acordada antes de empezar"</span>,
  <span class="text-mist">precio</span>: <span class="text-cyan">"fijo por ciclo"</span>,
  <span class="text-mist">aprueba</span>: <span class="text-cyan">"tu equipo"</span>,
{'}'}</code></pre>
        </div>

        <div class="glass absolute -bottom-24 right-0 w-[220px] p-5 sm:-right-6 sm:w-[250px]">
          <p class="font-mono text-[12px] text-muted">Estado del ciclo</p>
          <ul class="mt-3 grid gap-2.5 text-[14px]">
            <li class="flex items-center gap-3 text-mist"><span class="flex size-5 items-center justify-center rounded-full bg-cyan text-[11px] text-ink">✓</span>Diagnóstico</li>
            <li class="flex items-center gap-3 text-mist"><span class="flex size-5 items-center justify-center rounded-full bg-cyan text-[11px] text-ink">✓</span>Acuerdo</li>
            <li class="flex items-center gap-3 text-white"><span class="size-5 rounded-full border-2 border-cyan shadow-[0_0_12px_rgb(116_255_246/0.8)]"></span>Construcción</li>
            <li class="flex items-center gap-3 text-muted"><span class="size-5 rounded-full border border-white/20"></span>Operación y mejora</li>
          </ul>
        </div>

        <div class="orb-fallback absolute -bottom-20 left-2 rounded-full shadow-[0_0_90px_rgb(116_255_246/0.45)] sm:-left-8">
          <FluidOrb client:idle size={132} color="#107d78" />
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Propuesta -->
  <section class="section" aria-labelledby="propuesta">
    <div class="wrap">
      <SectionHeading id="propuesta" eyebrow="Alcance, fecha y precio acordados" title="Antes de empezar, sabes qué recibes, cuándo y cuánto pagas." />
      <div class="mt-12 grid gap-4 md:grid-cols-3">
        {
          promise.map((p, i) => (
            <div class="glass p-7">
              <span class="font-mono text-sm text-cyan">0{i + 1}</span>
              <h3 class="mt-8 text-2xl font-medium tracking-tight">{p.title}</h3>
              <p class="mt-3 text-mist">{p.body}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-8 max-w-3xl text-lg text-mist">
        Todo empieza con un diagnóstico inicial. Sales con el plan, el alcance y el precio del primer ciclo.
      </p>
    </div>
  </section>

  <!-- 3. Cómo trabajamos -->
  <section class="section pt-0" aria-labelledby="metodo">
    <div class="wrap">
      <SectionHeading id="metodo" eyebrow="Cómo trabajamos" title="Un método simple, en cuatro pasos." />
      <div class="mt-12"><Steps steps={method} /></div>
    </div>
  </section>

  <!-- 4. Casos -->
  <section class="section pt-0" aria-labelledby="casos">
    <div class="wrap">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <SectionHeading
          id="casos"
          eyebrow="Casos"
          title="Experiencia que ya está en producción."
          lead="Agentes de IA, automatizaciones y productos financieros que lideró nuestro fundador, con sus resultados medidos."
        />
        <a href="/casos/" class="btn btn-ghost shrink-0">Ver todos los casos <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="mt-12 grid gap-4 md:grid-cols-3">
        {featuredCases.map((c) => <CaseCard item={c} />)}
      </div>
    </div>
  </section>

  <!-- 5. Servicios -->
  <section id="servicios" class="section pt-0" aria-labelledby="servicios-titulo">
    <div class="wrap">
      <SectionHeading id="servicios-titulo" eyebrow="Servicios" title="Tres formas de poner la IA a trabajar para ti." />
      <div class="mt-12 grid gap-4 lg:grid-cols-3">
        {
          services.map((s, i) => (
            <article class="glass group relative flex flex-col p-7 transition-colors hover:border-cyan/40">
              <span class="font-mono text-sm text-cyan">0{i + 1}</span>
              <h3 class="mt-10 text-3xl font-medium tracking-tight">{s.name}</h3>
              <p class="mt-3 text-mist">{s.short}</p>
              <a href={`/servicios/${s.slug}/`} class="mt-10 inline-flex items-center gap-2 font-medium text-cyan after:absolute after:inset-0 after:rounded-[24px]">
                {s.cardCta} <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 6. Sectores -->
  <section class="section pt-0" aria-labelledby="sectores">
    <div class="wrap">
      <SectionHeading id="sectores" eyebrow="Sectores" title="Conocemos tu industria." />
      <div class="mt-12 grid gap-4 md:grid-cols-3">
        {
          sectors.map((s) => (
            <a href={`/sectores/${s.slug}/`} class="glass group block p-7 transition-colors hover:border-cyan/40">
              <h3 class="text-2xl font-medium tracking-tight">{s.name}</h3>
              <p class="mt-3 text-mist">{s.summary}</p>
              <span class="mt-8 inline-flex items-center gap-2 text-[15px] text-cyan">
                IA para {s.name.toLowerCase()} <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 7. Quién está detrás -->
  <section class="section pt-0" aria-labelledby="quien">
    <div class="wrap">
      <div class="glass relative overflow-hidden p-7 sm:p-12">
        <div class="glow-bottom" aria-hidden="true"></div>
        <div class="relative grid gap-10 lg:grid-cols-[1fr_1.3fr]">
          <div>
            <p class="eyebrow mb-5">Quién está detrás</p>
            <h2 id="quien" class="sheen text-[clamp(30px,4vw,48px)]">Liderado por quien ha construido tecnología corporativa durante más de 12 años.</h2>
          </div>
          <div class="text-lg text-mist">
            <p>
              <strong class="font-medium text-white">Mijalys Silva</strong> es CEO de Inteligenze. Ha liderado soluciones tecnológicas corporativas durante más de 12 años en banca, pagos y tecnología, y hoy tiene agentes de IA en uso en los sectores financiero y logístico. Participó en Wayra (Fundación Telefónica) con DUHEM, el primer e-commerce de comercio justo de Latinoamérica, y es conferencista en IA.
            </p>
            <p class="mt-4">
              Inteligenze forma parte del batch de Google for Startups en la categoría de IA Generativa. Su tesis: la IA solo vale cuando se traduce en resultados que puedes medir.
            </p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a href="/nosotros/" class="btn btn-ghost btn-sm">Conoce al equipo</a>
              <a href="https://www.linkedin.com/in/mijalysilvaux" class="btn btn-ghost btn-sm" rel="noopener">LinkedIn <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. Preguntas frecuentes -->
  <section class="section pt-0" aria-labelledby="faq">
    <div class="wrap grid gap-10 lg:grid-cols-[1fr_1.6fr]">
      <SectionHeading id="faq" eyebrow="Preguntas frecuentes" title="Lo que suelen preguntarnos." />
      <Faq faqs={homeFaqs} />
    </div>
  </section>

  <!-- 9. Contacto -->
  <section class="section pt-0" aria-labelledby="contacto">
    <div class="wrap grid gap-10 lg:grid-cols-[1fr_1.4fr]">
      <div>
        <SectionHeading id="contacto" eyebrow="Contacto" title="Cuéntanos qué necesitas." lead={`Te respondemos en menos de ${site.responseHours} horas, sin compromiso.`} />
      </div>
      <ContactForm id="form-inicio" />
    </div>
  </section>
</Base>
