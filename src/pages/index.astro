---
import Base from '@/layouts/Base.astro'
import Icon from '@/components/Icon.astro'
import CorpHeading from '@/components/corp/CorpHeading.astro'
import CorpCaseCard from '@/components/corp/CorpCaseCard.astro'
import FounderCard from '@/components/corp/FounderCard.astro'
import { founder, method, promise } from '@/data/site'
import { services } from '@/data/services'
import { sectors } from '@/data/sectors'
import { aiCases } from '@/data/cases'

// Trayectoria: resultados medidos en productos digitales (ver cada caso)
const results = [
  { value: '−36%', label: 'Tiempo en pedidos recurrentes', source: 'Primax Solutions', slug: 'primax' },
  { value: '−25%', label: 'Consultas a atención al cliente', source: 'Caja Metropolitana', slug: 'caja-metropolitana' },
  { value: '+25%', label: 'Satisfacción del cliente', source: 'Redeban', slug: 'redeban' },
  { value: '+20%', label: 'Retención móvil', source: 'Caja Metropolitana', slug: 'caja-metropolitana' },
]
const trust = [
  { big: '12+ años', small: 'liderando tecnología corporativa' },
  { big: 'Google for Startups', small: 'Batch IA Generativa' },
  { big: 'Wayra', small: 'Fundación Telefónica' },
  { big: 'Banca y pagos', small: 'experiencia en productos regulados' },
]
const promiseIcons = ['scope', 'calendar', 'price'] as const

const title = 'Inteligenze | Consultora de IA en Perú: agentes y automatización'
const description =
  'Consultora de IA en Lima. Agentes y software a medida, automatización de procesos y ciberseguridad, con alcance, fecha y precio acordados antes de empezar.'
---

<Base title={title} bareTitle description={description} corp>
  <!-- 1. Portada -->
  <section class="border-b border-rule">
    <div class="wrap grid items-center gap-12 py-16 lg:grid-cols-[1.15fr_1fr] lg:gap-16 lg:py-24">
      <div>
        <p class="kicker">Consultora de IA · Lima, Perú</p>
        <h1 class="mt-5 text-[clamp(38px,5vw,60px)] leading-[1.05]">
          Construimos, automatizamos y protegemos tu empresa con IA.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-text-2 sm:text-xl">
          Agentes y software a medida, automatización de procesos y ciberseguridad, con alcance, fecha y precio acordados antes de empezar.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href="/contacto/" class="btn btn-navy">Agenda un diagnóstico <span class="arrow" aria-hidden="true">→</span></a>
          <a href="/servicios/" class="btn btn-outline">Conoce los servicios</a>
        </div>
      </div>

      <!-- Panel: el método en una mirada -->
      <aside class="on-dark grid-lines relative overflow-hidden rounded-2xl bg-navy p-7 text-white sm:p-9" aria-labelledby="panel-metodo">
        <div class="absolute -right-24 -top-24 size-72 rounded-full bg-[radial-gradient(circle,rgb(116_255_246/0.22),transparent_65%)]" aria-hidden="true"></div>
        <p class="kicker relative">Cómo trabajamos</p>
        <h2 id="panel-metodo" class="relative mt-3 text-2xl text-white">Un ciclo claro, de principio a fin</h2>
        <ol class="relative mt-7 grid gap-5">
          {
            method.map((m, i) => (
              <li class="grid grid-cols-[36px_1fr] gap-4">
                <span class="flex size-9 items-center justify-center rounded-full border border-cyan/50 text-[14px] font-semibold text-cyan">{i + 1}</span>
                <div>
                  <p class="font-semibold">{m.title}</p>
                  <p class="mt-0.5 text-[14px] text-mist">Entrega: {m.deliverable}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <div class="relative mt-8 flex flex-wrap gap-2 border-t border-white/10 pt-6 text-[13px]">
          {promise.map((p) => <span class="rounded-full border border-white/15 px-3 py-1.5 text-mist">{p.title}</span>)}
        </div>
      </aside>
    </div>
  </section>

  <!-- 2. Respaldo -->
  <section class="border-b border-rule bg-surface" aria-label="Respaldo">
    <ul class="wrap grid grid-cols-2 gap-y-8 py-10 lg:grid-cols-4">
      {
        trust.map((t, i) => (
          <li class:list={['px-1 lg:px-6', i > 0 && 'lg:border-l lg:border-rule']}>
            <p class="text-lg font-semibold">{t.big}</p>
            <p class="mt-1 text-[14px] text-text-3">{t.small}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 3. Servicios -->
  <section class="section" aria-labelledby="servicios">
    <div class="wrap">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <CorpHeading id="servicios" kicker="Servicios" title="Tres formas de poner la IA a trabajar para tu empresa." />
        <a href="/servicios/" class="link-arrow shrink-0">Ver todos los servicios →</a>
      </div>
      <div class="mt-12 grid gap-5 lg:grid-cols-3">
        {
          services.map((s) => (
            <article class="card is-link group relative flex flex-col border-t-[3px] border-t-teal p-7" data-reveal>
              <span class="flex size-11 items-center justify-center rounded-lg bg-surface text-teal">
                <Icon name={s.icon} class="size-6" />
              </span>
              <h3 class="mt-6 text-2xl">
                <a href={`/servicios/${s.slug}/`} class="after:absolute after:inset-0">{s.name}</a>
              </h3>
              <p class="mt-3 leading-relaxed text-text-2">{s.short}</p>
              <ul class="mt-6 grid gap-2.5 border-t border-rule pt-6 text-[15px] text-text-2">
                {s.deliverables.map((d) => (
                  <li class="flex items-start gap-2.5">
                    <Icon name="check" class="mt-0.5 size-4 shrink-0 text-teal" />
                    {d.title}
                  </li>
                ))}
              </ul>
              <span class="link-arrow mt-auto pt-7">{s.cardCta} →</span>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4. Propuesta -->
  <section class="section border-y border-rule bg-surface" aria-labelledby="propuesta">
    <div class="wrap grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-20">
      <div>
        <CorpHeading
          id="propuesta"
          kicker="Nuestra forma de trabajar"
          title="Antes de empezar, sabes qué recibes, cuándo y cuánto pagas."
          lead="Todo empieza con un diagnóstico inicial. Sales con el plan, el alcance y el precio del primer ciclo, por escrito."
        />
        <a href="/contacto/" class="btn btn-navy mt-8">Agenda un diagnóstico</a>
      </div>
      <ul class="grid content-start divide-y divide-rule border-y border-rule">
        {
          promise.map((p, i) => (
            <li class="grid grid-cols-[48px_1fr] gap-5 py-7" data-reveal>
              <span class="flex size-12 items-center justify-center rounded-xl bg-white text-teal shadow-[0_1px_0_rgb(5_11_28/0.06)] ring-1 ring-rule">
                <Icon name={promiseIcons[i]} class="size-6" />
              </span>
              <div>
                <h3 class="text-xl">{p.title}</h3>
                <p class="mt-2 leading-relaxed text-text-2">{p.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 5. Casos -->
  <section class="section" aria-labelledby="casos">
    <div class="wrap">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <CorpHeading
          id="casos"
          kicker="Casos"
          title="IA que ya construimos."
          lead="Agentes y automatizaciones diseñados y construidos por el equipo fundador de Inteligenze."
        />
        <a href="/casos/" class="link-arrow shrink-0">Ver todos los casos →</a>
      </div>
      <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {aiCases.map((c) => <CorpCaseCard item={c} />)}
      </div>
    </div>
  </section>

  <!-- 6. Trayectoria en cifras -->
  <section class="on-dark bg-navy text-white" aria-labelledby="trayectoria">
    <div class="wrap grid gap-12 py-20 lg:grid-cols-[1fr_2fr] lg:items-end">
      <CorpHeading id="trayectoria" kicker="Trayectoria" title="Más de 12 años mejorando productos de banca y pagos." dark />
      <ul class="grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-4" data-reveal>
        {
          results.map((r) => (
            <li class="border-t border-white/15 pt-5">
              <p class="text-4xl font-semibold tracking-tight text-cyan"><span data-countup>{r.value}</span></p>
              <p class="mt-2 text-[15px] text-white">{r.label}</p>
              <a href={`/casos/${r.slug}/`} class="mt-1 inline-block text-[13px] text-mist hover:text-white">{r.source} →</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 7. Sectores -->
  <section class="section" aria-labelledby="sectores">
    <div class="wrap">
      <CorpHeading id="sectores" kicker="Sectores" title="Conocemos tu industria." />
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {
          sectors.map((s) => (
            <a href={`/sectores/${s.slug}/`} class="card group flex flex-col p-7" data-reveal>
              <span class="flex size-11 items-center justify-center rounded-lg bg-surface text-teal">
                <Icon name={s.icon} class="size-6" />
              </span>
              <h3 class="mt-6 text-xl">{s.name}</h3>
              <p class="mt-2 leading-relaxed text-text-2">{s.summary}</p>
              <span class="link-arrow mt-6">IA para {s.name.toLowerCase()} →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 8. Liderazgo -->
  <section class="section border-t border-rule bg-surface" aria-labelledby="liderazgo">
    <div class="wrap grid items-center gap-12 md:grid-cols-[minmax(0,320px)_1fr] lg:gap-20">
      <div class="mx-auto w-full max-w-[320px]" data-reveal><FounderCard /></div>
      <div data-reveal>
        <p class="kicker">Liderazgo</p>
        <blockquote class="mt-5 text-[clamp(24px,2.8vw,34px)] font-semibold leading-snug tracking-tight">
          “La IA solo vale cuando se traduce en resultados que puedes medir.”
        </blockquote>
        <p class="mt-6 font-semibold">{founder.name}</p>
        <p class="text-text-3">{founder.role}</p>
        <p class="mt-6 max-w-2xl leading-relaxed text-text-2">
          Más de 12 años liderando soluciones tecnológicas en banca, pagos y tecnología, hoy con agentes de IA en uso en los sectores financiero y logístico. Participó en Wayra (Fundación Telefónica) y Inteligenze forma parte del batch de Google for Startups en IA Generativa.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/nosotros/" class="btn btn-outline btn-sm">Conoce al equipo</a>
          <a href={founder.linkedin} class="btn btn-outline btn-sm" rel="noopener">LinkedIn ↗</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 9. Cierre -->
  <section class="on-dark grid-lines bg-navy text-white" aria-labelledby="cierre">
    <div class="wrap flex flex-col items-start justify-between gap-8 py-20 lg:flex-row lg:items-center">
      <div class="max-w-2xl">
        <h2 id="cierre" class="text-[clamp(28px,3.4vw,42px)] leading-tight text-white">Conversemos sobre lo que tu empresa necesita.</h2>
        <p class="mt-4 text-lg text-mist">Te respondemos en menos de 48 horas, sin compromiso.</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a href="/contacto/" class="btn btn-white">Agenda un diagnóstico <span class="arrow" aria-hidden="true">→</span></a>
        <a href="/diagnosticos/" class="btn btn-ghost">Diagnósticos gratuitos</a>
      </div>
    </div>
  </section>
</Base>
