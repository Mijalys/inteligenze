---
import Base from '@/layouts/Base.astro'
import SectionHeading from '@/components/SectionHeading.astro'
import Steps from '@/components/Steps.astro'
import CaseCard from '@/components/CaseCard.astro'
import Faq from '@/components/Faq.astro'
import ContactForm from '@/components/ContactForm.astro'
import FluidOrb from '@/components/FluidOrb.astro'
import Icon from '@/components/Icon.astro'
import FounderPhoto from '@/components/FounderPhoto.astro'
import { homeFaqs, method, proof, promise, site } from '@/data/site'
import { services } from '@/data/services'
import { sectors } from '@/data/sectors'
import { aiCases } from '@/data/cases'
import { faqPage } from '@/lib/schema'

// Resultados medidos de los casos; bar = largo relativo de la barra (escala visual)
const results = [
  { value: '−36%', dir: 'down', bar: 72, label: 'Tiempo en pedidos recurrentes', source: 'Primax Solutions', slug: 'primax' },
  { value: '−25%', dir: 'down', bar: 50, label: 'Consultas a atención al cliente', source: 'Caja Metropolitana', slug: 'caja-metropolitana' },
  { value: '+25%', dir: 'up', bar: 50, label: 'Satisfacción del cliente', source: 'Redeban', slug: 'redeban' },
  { value: '+20%', dir: 'up', bar: 40, label: 'Retención móvil', source: 'Caja Metropolitana', slug: 'caja-metropolitana' },
] as const

const title = 'Inteligenze | Consultora de IA en Perú: agentes y automatización'
const description =
  'Consultora de IA en Lima. Agentes y software a medida, automatización de procesos y ciberseguridad, con alcance, fecha y precio acordados antes de empezar.'
---

<Base title={title} bareTitle description={description} schema={[faqPage(homeFaqs, '/')]}>
  <!-- 1. Hero -->
  <section class="relative overflow-hidden pb-20 pt-32 lg:pb-28 lg:pt-44">
    <div class="beam" aria-hidden="true"></div>
    <div class="glow-bottom" aria-hidden="true"></div>
    <div class="wrap relative grid items-center gap-14 lg:grid-cols-[1.1fr_1fr]">
      <div>
        <p class="chip enter">
          <svg class="pulse-dot size-4 text-cyan" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6"></path></svg>
          {site.tagline}
        </p>
        <h1 class="mt-8 text-[clamp(42px,6.6vw,84px)] font-medium leading-[0.98] tracking-[-0.045em]">
          {'Construimos, automatizamos y protegemos tu empresa'.split(' ').map((w, i) => <span class="word sheen" style={`--i:${i}`}>{w}</span><span> </span>)}
          <span class="whitespace-nowrap"><span class="brace">{'{'}</span><span class="word sheen" style="--i:7">&nbsp;con IA&nbsp;</span><span class="brace">{'}'}</span></span>
        </h1>
        <p class="enter mt-7 max-w-xl text-lg text-mist sm:text-xl" style="--delay:700ms">
          Con resultados acordados antes de empezar. Inteligenze es una consultora de IA que diseña agentes y software a medida, automatiza procesos y refuerza tu ciberseguridad. Definimos contigo qué se entrega, cuándo y a qué costo.
        </p>
        <div class="enter mt-9 flex flex-col gap-3 sm:flex-row" style="--delay:850ms">
          <a href="/contacto/" class="btn btn-primary">Agenda un diagnóstico <span class="arrow" aria-hidden="true">→</span></a>
          <a href="#servicios" class="btn btn-ghost">Conoce los servicios</a>
        </div>
        <ul class="mt-12 grid gap-3 text-[15px] text-mist sm:grid-cols-3 sm:gap-6" aria-label="Respaldo">
          {
            proof.map((p, i) => (
              <li class="enter flex gap-3 border-l border-cyan/40 pl-4" style={`--delay:${1000 + i * 120}ms`}>{p}</li>
            ))
          }
        </ul>
      </div>

      <!-- Visual: el orbe es el núcleo del agente; alrededor, los tres acuerdos y el estado del ciclo -->
      <div class="relative mx-auto w-full max-w-[520px] lg:mx-0 lg:justify-self-end" aria-hidden="true">
        <div class="relative mx-auto aspect-square w-full max-w-[460px]">
          <div class="absolute inset-[6%] rounded-full border border-dashed border-cyan/25"></div>
          <div class="absolute inset-[20%] rounded-full border border-white/[0.06]"></div>
          <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
            <div class="orb-fallback float rounded-full shadow-[0_0_140px_rgb(116_255_246/0.45)]">
              <FluidOrb size={220} color="#107d78" />
            </div>
          </div>
          <span class="orbit-chip absolute left-0 top-[12%] flex items-center gap-2.5 rounded-full border border-white/12 bg-ink-2/85 px-4 py-2.5 text-[14px] shadow-[0_12px_30px_rgb(0_0_0/0.35)] backdrop-blur-xl" style="--delay:900ms;--fdelay:1.8s">
            <Icon name="scope" class="size-5 text-cyan" />Alcance acordado
          </span>
          <span class="orbit-chip absolute right-0 top-[38%] flex items-center gap-2.5 rounded-full border border-white/12 bg-ink-2/85 px-4 py-2.5 text-[14px] shadow-[0_12px_30px_rgb(0_0_0/0.35)] backdrop-blur-xl" style="--delay:1050ms;--fdelay:2.6s">
            <Icon name="calendar" class="size-5 text-cyan" />Fecha definida
          </span>
          <span class="orbit-chip absolute bottom-[14%] left-[4%] flex items-center gap-2.5 rounded-full border border-white/12 bg-ink-2/85 px-4 py-2.5 text-[14px] shadow-[0_12px_30px_rgb(0_0_0/0.35)] backdrop-blur-xl" style="--delay:1200ms;--fdelay:3.4s">
            <Icon name="price" class="size-5 text-cyan" />Precio fijo por ciclo
          </span>
        </div>

        <div class="glass mt-6 w-full p-5 sm:absolute sm:-bottom-6 sm:right-0 sm:mt-0 sm:w-[250px]">
          <p class="font-mono text-[12px] text-muted">Estado del ciclo</p>
          <ul class="mt-3 grid gap-2.5 text-[14px]">
            <li class="flex items-center gap-3 text-mist"><span class="tick flex size-5 items-center justify-center rounded-full bg-cyan text-[11px] text-ink" style="--delay:1400ms">✓</span>Diagnóstico</li>
            <li class="flex items-center gap-3 text-mist"><span class="tick flex size-5 items-center justify-center rounded-full bg-cyan text-[11px] text-ink" style="--delay:1750ms">✓</span>Acuerdo</li>
            <li class="flex items-center gap-3 text-white"><span class="tick size-5 rounded-full border-2 border-cyan shadow-[0_0_12px_rgb(116_255_246/0.8)]" style="--delay:2100ms"></span>Construcción</li>
            <li class="flex items-center gap-3 text-muted"><span class="size-5 rounded-full border border-white/20"></span>Operación y mejora</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Propuesta -->
  <section class="section" aria-labelledby="propuesta">
    <div class="wrap">
      <SectionHeading id="propuesta" eyebrow="Alcance, fecha y precio acordados" title="Antes de empezar, sabes qué recibes, cuándo y cuánto pagas." />
      <div class="mt-12">
        <div class="grid gap-4 md:grid-cols-3">
          {
            promise.map((p, i) => (
              <div class="glass p-7">
                <div class="flex items-center justify-between">
                  <span class="flex size-12 items-center justify-center hop rounded-2xl border border-cyan/30 bg-cyan/10 text-cyan">
                    <Icon name={(['scope', 'calendar', 'price'] as const)[i]} class="size-6" />
                  </span>
                  <span class="font-mono text-sm text-muted">0{i + 1}</span>
                </div>
                <h3 class="mt-8 text-2xl font-medium tracking-tight">{p.title}</h3>
                <p class="mt-3 text-mist">{p.body}</p>
              </div>
            ))
          }
        </div>
        <!-- Los tres acuerdos convergen en un solo documento -->
        <svg data-reveal class="hidden h-16 w-full text-cyan md:block" viewBox="0 0 600 64" preserveAspectRatio="none" fill="none" aria-hidden="true">
          <path d="M100 0v24h400V0M300 24v40" stroke="currentColor" stroke-opacity="0.55" stroke-width="1.2" vector-effect="non-scaling-stroke"></path>
        </svg>
        <div class="mt-6 flex justify-center md:mt-0">
          <div class="glass flex flex-col items-center gap-4 px-6 py-5 text-center sm:flex-row sm:text-left">
            <span class="flex size-12 shrink-0 items-center justify-center rounded-full bg-cyan text-ink shadow-[0_0_40px_rgb(116_255_246/0.45)]">
              <Icon name="contract" class="size-6" />
            </span>
            <p class="max-w-md text-mist">
              <strong class="block font-medium text-white">Todo empieza con un diagnóstico inicial.</strong>
              Sales con el plan, el alcance y el precio del primer ciclo, por escrito.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Cómo trabajamos -->
  <section class="section pt-0" aria-labelledby="metodo">
    <div class="wrap">
      <SectionHeading id="metodo" eyebrow="Cómo trabajamos" title="Un método simple, en cuatro pasos." />
      <div class="mt-12"><Steps steps={method} /></div>
    </div>
  </section>

  <!-- 4. Casos -->
  <section class="section pt-0" aria-labelledby="casos">
    <div class="wrap">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <SectionHeading
          id="casos"
          eyebrow="Casos"
          title="IA que ya construimos."
          lead="Agentes y automatizaciones con IA diseñados y construidos por el equipo fundador de Inteligenze."
        />
        <a href="/casos/" class="btn btn-ghost shrink-0">Ver todos los casos <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="mt-12 grid gap-4 md:grid-cols-3">
        {aiCases.map((c) => <CaseCard item={c} />)}
      </div>
    </div>
  </section>

  <!-- Resultados medidos -->
  <section class="pb-[clamp(72px,10vw,136px)]" aria-labelledby="resultados">
    <div class="wrap">
      <div class="glass relative overflow-hidden p-7 sm:p-10">
        <div class="glow-bottom" aria-hidden="true"></div>
        <div class="relative">
          <p class="eyebrow">Trayectoria · resultados medidos</p>
          <h2 id="resultados" class="mt-4 max-w-2xl text-2xl font-medium tracking-tight sm:text-3xl">Antes de la IA, más de 12 años mejorando productos de banca y pagos.</h2>
          <ul class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
            {
              results.map((r) => (
                <li>
                  <p class="flex items-center gap-2 text-5xl font-medium tracking-tight">
                    <Icon name={r.dir === 'up' ? 'arrowUp' : 'arrowDown'} class="size-7 text-cyan" />
                    <span data-countup>{r.value}</span>
                  </p>
                  <div class="mt-4 h-1.5 rounded-full bg-white/10">
                    <div class="bar-grow h-1.5 rounded-full bg-gradient-to-r from-cyan-deep to-cyan" style={`width:${r.bar}%`} />
                  </div>
                  <p class="mt-3 text-white">{r.label}</p>
                  <a href={`/casos/${r.slug}/`} class="mt-1 inline-block text-[14px] text-muted hover:text-cyan">{r.source} →</a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Servicios -->
  <section id="servicios" class="section pt-0" aria-labelledby="servicios-titulo">
    <div class="wrap">
      <SectionHeading id="servicios-titulo" eyebrow="Servicios" title="Tres formas de poner la IA a trabajar para ti." />
      <div class="mt-12 grid gap-4 lg:grid-cols-3">
        {
          services.map((s, i) => (
            <article class="glass group relative flex flex-col p-7 transition-colors hover:border-cyan/40">
              <div class="flex items-center justify-between">
                <span class="flex size-14 items-center justify-center hop rounded-2xl border border-cyan/30 bg-cyan/10 text-cyan">
                  <Icon name={s.icon} class="size-7" />
                </span>
                <span class="font-mono text-sm text-muted">0{i + 1}</span>
              </div>
              <h3 class="mt-8 text-3xl font-medium tracking-tight">{s.name}</h3>
              <p class="mt-3 text-mist">{s.short}</p>
              <ul class="mt-6 grid gap-2.5 border-t border-white/10 pt-6 text-[15px]">
                {s.deliverables.map((d) => (
                  <li class="flex items-start gap-2.5">
                    <Icon name="check" class="mt-0.5 size-4 shrink-0 text-cyan" />
                    {d.title}
                  </li>
                ))}
              </ul>
              <a href={`/servicios/${s.slug}/`} class="mt-auto pt-8 inline-flex items-center gap-2 font-medium text-cyan after:absolute after:inset-0 after:rounded-[24px]">
                {s.cardCta} <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 6. Sectores -->
  <section class="section pt-0" aria-labelledby="sectores">
    <div class="wrap">
      <SectionHeading id="sectores" eyebrow="Sectores" title="Conocemos tu industria." />
      <div class="mt-12 grid gap-4 md:grid-cols-3">
        {
          sectors.map((s) => (
            <a href={`/sectores/${s.slug}/`} class="glass group block p-7 transition-colors hover:border-cyan/40">
              <span class="flex size-12 items-center justify-center hop rounded-2xl border border-cyan/30 bg-cyan/10 text-cyan">
                <Icon name={s.icon} class="size-6" />
              </span>
              <h3 class="mt-6 text-2xl font-medium tracking-tight">{s.name}</h3>
              <p class="mt-3 text-mist">{s.summary}</p>
              <span class="mt-8 inline-flex items-center gap-2 text-[15px] text-cyan">
                IA para {s.name.toLowerCase()} <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 7. Quién está detrás -->
  <section class="section pt-0" aria-labelledby="quien">
    <div class="wrap">
      <div class="glass relative overflow-hidden p-7 sm:p-12">
        <div class="glow-bottom" aria-hidden="true"></div>
        <div class="relative grid gap-10 lg:grid-cols-[1fr_1.3fr]">
          <div>
            <FounderPhoto class="mb-8 size-28" />
            <p class="eyebrow mb-5">Quién está detrás</p>
            <h2 id="quien" class="sheen text-[clamp(30px,4vw,48px)]">Liderado por quien ha construido tecnología corporativa durante más de 12 años.</h2>
          </div>
          <div class="text-lg text-mist">
            <p>
              <strong class="font-medium text-white">Mijalys Silva</strong> es CEO de Inteligenze. Ha liderado soluciones tecnológicas corporativas durante más de 12 años en banca, pagos y tecnología, y hoy tiene agentes de IA en uso en los sectores financiero y logístico. Participó en Wayra (Fundación Telefónica) con DUHEM, el primer e-commerce de comercio justo de Latinoamérica, y es conferencista en IA.
            </p>
            <p class="mt-4">
              Inteligenze forma parte del batch de Google for Startups en la categoría de IA Generativa. Su tesis: la IA solo vale cuando se traduce en resultados que puedes medir.
            </p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a href="/nosotros/" class="btn btn-ghost btn-sm">Conoce al equipo</a>
              <a href="https://www.linkedin.com/in/mijalysilvaux" class="btn btn-ghost btn-sm" rel="noopener">LinkedIn <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. Preguntas frecuentes -->
  <section class="section pt-0" aria-labelledby="faq">
    <div class="wrap grid gap-10 lg:grid-cols-[1fr_1.6fr]">
      <SectionHeading id="faq" eyebrow="Preguntas frecuentes" title="Lo que suelen preguntarnos." />
      <Faq faqs={homeFaqs} />
    </div>
  </section>

  <!-- 9. Contacto -->
  <section class="section pt-0" aria-labelledby="contacto">
    <div class="wrap grid gap-10 lg:grid-cols-[1fr_1.4fr]">
      <div>
        <SectionHeading id="contacto" eyebrow="Contacto" title="Cuéntanos qué necesitas." lead={`Te respondemos en menos de ${site.responseHours} horas, sin compromiso.`} />
      </div>
      <ContactForm id="form-inicio" />
    </div>
  </section>
</Base>
