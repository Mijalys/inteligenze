---
import Base from '@/layouts/Base.astro'
import Icon from '@/components/Icon.astro'
import CorpPageHero from '@/components/corp/CorpPageHero.astro'
import CorpCta from '@/components/corp/CorpCta.astro'
import { site } from '@/data/site'

const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Diagnósticos gratuitos', path: '/diagnosticos/' },
]
const tools = [
  {
    name: 'Madurez en IA',
    href: '/diagnosticos/madurez-ia/',
    icon: 'chart' as const,
    measures: 'Qué tan preparada está tu empresa para adoptar IA: datos, procesos, equipo y gobierno.',
    gets: 'Puntaje por área y recomendaciones de por dónde empezar.',
    cta: 'Hacer el test',
    time: '3 minutos',
  },
  {
    name: 'Autoevaluación de ciberseguridad',
    href: '/diagnosticos/ciberseguridad/',
    icon: 'shield' as const,
    measures: 'Tu exposición frente a phishing, accesos y respuesta a incidentes.',
    gets: 'Nivel de riesgo y las acciones más urgentes.',
    cta: 'Evaluar mi riesgo',
    time: '3 minutos',
  },
  {
    name: 'Calculadora de ahorro por automatización',
    href: '/diagnosticos/calculadora-ahorro/',
    icon: 'price' as const,
    measures: 'Horas y costo que hoy consume un proceso manual.',
    gets: 'Ahorro estimado mensual y anual.',
    cta: 'Calcular mi ahorro',
    time: '1 minuto',
  },
]
---

<Base
  title="Diagnósticos gratuitos de IA, ciberseguridad y ahorro"
  description="Tres herramientas gratuitas para medir tu madurez en IA, tu exposición en ciberseguridad y el ahorro posible con automatización. Resultado inmediato."
  pageType="CollectionPage"
  breadcrumbs={crumbs}
>
  <CorpPageHero
    kicker="Diagnósticos gratuitos"
    title="Descubre en minutos dónde está tu empresa y por dónde empezar."
    lead="Tres herramientas gratuitas con resultado inmediato. Si quieres, luego lo revisas con nuestro equipo."
    crumbs={crumbs}
  />

  <section class="section" aria-label="Herramientas">
    <div class="wrap grid gap-5 lg:grid-cols-3">
      {
        tools.map((t) => (
          <a href={t.href} class="card flex flex-col p-7" data-reveal>
            <div class="flex items-center justify-between">
              <span class="flex size-12 items-center justify-center rounded-xl bg-navy text-cyan"><Icon name={t.icon} class="size-6" /></span>
              <span class="rounded-full bg-surface px-3 py-1 text-[13px] font-medium text-text-2">{t.time}</span>
            </div>
            <h2 class="mt-6 text-2xl">{t.name}</h2>
            <dl class="mt-5 grid gap-4 border-t border-rule pt-5 text-[15px]">
              <div>
                <dt class="text-[12px] font-semibold uppercase tracking-[0.08em] text-text-3">Qué mide</dt>
                <dd class="mt-1 text-text-2">{t.measures}</dd>
              </div>
              <div>
                <dt class="text-[12px] font-semibold uppercase tracking-[0.08em] text-text-3">Qué recibes</dt>
                <dd class="mt-1 text-text-2">{t.gets}</dd>
              </div>
            </dl>
            <span class="link-arrow mt-auto pt-7">{t.cta} →</span>
          </a>
        ))
      }
    </div>
    <p class="wrap mt-8 text-[15px] text-text-3">
      Antes de mostrar el resultado completo te pedimos nombre, correo corporativo, empresa y cargo. Puedes revisarlo luego con un especialista en una conversación de {site.meetingMinutes} minutos.
    </p>
  </section>

  <CorpCta title="¿Prefieres hablar directamente?" />
</Base>
