---
import Base from '@/layouts/Base.astro'
import Icon from '@/components/Icon.astro'
import CorpPageHero from '@/components/corp/CorpPageHero.astro'
import CorpHeading from '@/components/corp/CorpHeading.astro'
import CorpCta from '@/components/corp/CorpCta.astro'
import FounderCard from '@/components/corp/FounderCard.astro'
import { founder, site } from '@/data/site'

const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Nosotros', path: '/nosotros/' },
]

const track = [
  { big: `${site.foundingYearsExperience}+ años`, small: 'liderando soluciones tecnológicas en banca, pagos y tecnología' },
  { big: 'Google for Startups', small: 'batch de IA Generativa, con especialidad en diseño conversacional' },
  { big: 'Agentes en uso', small: 'en los sectores financiero y logístico' },
  { big: 'Wayra', small: 'trayectoria previa con Fundación Telefónica' },
]

const principles = [
  { t: 'Resultados, no horas', b: 'Lo importante es lo que se entrega y se mide.', icon: 'chart' as const },
  { t: 'Claridad antes de empezar', b: 'Alcance, fecha y precio por escrito.', icon: 'contract' as const },
  { t: 'Personas al mando', b: 'La IA acelera, las personas deciden.', icon: 'users' as const },
  { t: 'Seguridad desde el diseño', b: 'Protegemos tus datos y tu operación.', icon: 'shield' as const },
]

const career = [
  { org: 'Headland', role: 'Líder del programa de formación en IA', when: '2026 – hoy' },
  { org: 'Wirbi', role: 'Board Member, vertical de IA y Product', when: '2026 – hoy' },
  { org: 'Ventabot', role: 'Co-Founder y CPO · Google for Startups', when: '2024 – 2025' },
  { org: 'Primax Solutions', role: 'Product Designer', when: '2023' },
  { org: 'Niubiz', role: 'Product Designer', when: '2022' },
  { org: 'Redeban', role: 'Lead Product Designer', when: '2021 – 2022' },
  { org: 'Caja Metropolitana de Lima', role: 'Lead Product Designer', when: '2021' },
  { org: 'Caja Cusco', role: 'Product Designer', when: '2020' },
  { org: 'Banco Ripley Perú', role: 'Head of UX Design', when: '2018 – 2020' },
]
---

<Base
  title="Nosotros: consultora de IA liderada por Mijalys Silva"
  description="Consultora de IA en Lima liderada por Mijalys Silva, con más de 12 años en banca, pagos y tecnología. Parte del batch de Google for Startups (IA Generativa)."
  pageType="AboutPage"
  breadcrumbs={crumbs}
>
  <CorpPageHero
    kicker="Nosotros"
    title="Una consultora de IA que traduce tecnología en resultados."
    lead="Diseñamos agentes y software a medida, automatizamos procesos, protegemos la operación y sumamos talento. Acordamos qué se entrega, cuándo y a qué costo, y medimos el resultado."
    crumbs={crumbs}
  />

  <section class="border-b border-rule bg-surface" aria-label="Trayectoria">
    <ul class="wrap grid grid-cols-2 gap-y-8 py-10 lg:grid-cols-4">
      {
        track.map((t, i) => (
          <li class:list={['px-1 lg:px-6', i > 0 && 'lg:border-l lg:border-rule']}>
            <p class="text-lg font-semibold">{t.big}</p>
            <p class="mt-1 text-[14px] text-text-3">{t.small}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section" aria-labelledby="liderazgo">
    <div class="wrap grid gap-12 lg:grid-cols-[minmax(0,340px)_1fr_minmax(0,360px)] lg:gap-14">
      <div class="mx-auto w-full max-w-[340px]" data-reveal><FounderCard /></div>
      <div data-reveal>
        <p class="kicker">Liderazgo</p>
        <h2 id="liderazgo" class="mt-3 text-3xl">{founder.name}</h2>
        <p class="text-text-3">{founder.role}</p>
        <div class="mt-6 grid gap-4 leading-relaxed text-text-2">
          <p>Product Engineer con más de 12 años en banca y tecnología. Cubre el recorrido completo: entiende el problema de negocio, rediseña el proceso, diseña la orquestación de agentes, construye el sistema y lo lleva a producción.</p>
          <p>Construye con LangChain, Vertex AI, n8n, Copilot Studio, Power Automate y MCP, y aplica harness engineering para que los agentes sean predecibles, verificables y auditables.</p>
          <p>Participó en Wayra (Fundación Telefónica) con DUHEM, el primer e-commerce de comercio justo de Latinoamérica. Fue docente de Educación Continua en UX en Toulouse Lautrec entre 2019 y 2024, y es conferencista en IA.</p>
        </div>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={founder.linkedin} class="btn btn-outline btn-sm" rel="noopener">LinkedIn ↗</a>
          <a href={founder.portfolio} class="btn btn-outline btn-sm" rel="noopener">Portafolio ↗</a>
        </div>
      </div>
      <div data-reveal>
        <p class="kicker">Recorrido</p>
        <ol class="mt-3 border-t border-rule">
          {
            career.map((c) => (
              <li class="grid grid-cols-[1fr_auto] gap-4 border-b border-rule py-3">
                <span>
                  <span class="block font-semibold">{c.org}</span>
                  <span class="block text-[14px] text-text-3">{c.role}</span>
                </span>
                <span class="text-[13px] text-text-3">{c.when}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section border-t border-rule bg-surface" aria-labelledby="principios">
    <div class="wrap">
      <CorpHeading id="principios" kicker="Nuestros principios" title="Cómo decidimos" />
      <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {
          principles.map((p) => (
            <div class="card p-7" data-reveal>
              <span class="flex size-11 items-center justify-center rounded-lg bg-surface text-teal"><Icon name={p.icon} class="size-6" /></span>
              <h3 class="mt-6 text-lg">{p.t}</h3>
              <p class="mt-2 text-text-2">{p.b}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CorpCta title="Conversemos sobre lo que tu empresa necesita." primary={{ label: 'Contactar', href: '/contacto/' }} />
</Base>
