---
import Base from '@/layouts/Base.astro'
import CorpPageHero from '@/components/corp/CorpPageHero.astro'
---

<Base title="Página no encontrada" description="La página que buscas no existe o cambió de dirección." noindex>
  <CorpPageHero kicker="Error 404" title="Esta página no existe." lead="Puede que haya cambiado de dirección. Estas te pueden servir:">
    <div class="mt-9 flex flex-col gap-3 sm:flex-row">
      <a href="/" class="btn btn-navy">Ir al inicio</a>
      <a href="/servicios/" class="btn btn-outline">Servicios</a>
      <a href="/contacto/" class="btn btn-outline">Contacto</a>
    </div>
  </CorpPageHero>
</Base>
